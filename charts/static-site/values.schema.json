{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "static-site chart values",
  "description": "Strict at the top level: unknown keys are rejected so a typo fails the render. Kubernetes passthrough fields stay open.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "service-lib": { "type": "object", "description": "Helm adds a key for every dependency; the library takes no values" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity-check": {
          "type": "object",
          "additionalProperties": false,
          "description": "the identity check hook's image (truvity/k8s cmd/identity-check)",
          "required": ["repository", "digest"],
          "properties": {
            "registry": { "type": "string" },
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": { "type": "string", "pattern": "^[^@\\s]*$", "description": "registry/repository[:tag], no digest: that is artifact.digest" },
            "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" }
          }
        },
        "pullSecretName": { "type": "string" },
        "plainHTTP": { "type": "boolean" },
        "spaFallback": { "type": "boolean" },
        "notFoundPage": { "type": "string" },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "maxFiles": { "type": "integer", "minimum": 1 },
        "contentSizeLimit": { "type": "string", "minLength": 1 }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": { "enum": ["dockerconfig", "ecr", "none"], "description": "dockerconfig: the Docker config of site.pullSecretName (default); ecr: the server authenticates to Amazon ECR through the AWS SDK default credential chain; none: anonymous" },
        "ack": {
          "type": "object",
          "additionalProperties": false,
          "description": "the ServiceAccount's AWS identity on EKS is static-site-infra's (the same keys); this chart reads enabled and accountId: with registry.auth=ecr it renders no ServiceAccount and the identity check hook, which passes accountId (when set) as the account the pod must run in",
          "properties": {
            "enabled": { "type": "boolean" },
            "clusterName": { "type": "string", "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,99})?$" },
            "repositoryArns": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^arn:aws[a-z-]*:ecr:[a-z0-9-]+:[0-9]{12}:repository/[a-z0-9._/-]+$" } },
            "rolePrefix": { "type": "string", "pattern": "^([a-zA-Z0-9+=,.@_-]{1,64})?$" },
            "accountId": { "type": "string", "pattern": "^([0-9]{12})?$" },
            "region": { "type": "string", "pattern": "^([a-z]{2}(-[a-z]+)+-[0-9]+)?$" },
            "tags": { "type": "object", "additionalProperties": { "type": "string" } },
            "permissionsBoundary": { "type": "string", "pattern": "^(arn:aws[a-z-]*:iam::[0-9]{12}:policy/.+)?$" }
          }
        }
      }
    },
    "placeholders": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
      "properties": {
        "secretName": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?)?$" },
        "secretKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }
        },
        "optionalKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }
        },
        "externalSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["storeRef", "remoteKey", "properties"],
          "properties": {
            "storeRef": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "name"],
              "properties": {
                "kind": { "enum": ["ClusterSecretStore", "SecretStore"] },
                "name": { "type": "string", "minLength": 1 }
              }
            },
            "remoteKey": { "type": "string", "minLength": 1 },
            "properties": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "refreshInterval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "ignoreHealthcheck": { "type": "boolean" },
            "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      },
      "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9 ._:/@#+=,~-]{0,512}$" }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hashedPattern": { "type": "string" },
        "htmlMaxAge": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "staleWhileRevalidate": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" }
      }
    },
    "headers": { "type": "object", "additionalProperties": { "type": "string" } },
    "logLevel": { "enum": ["debug", "info", "warn", "error"] },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "resources": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array", "items": { "type": "object" } },
        "metricsFrom": { "type": "array", "items": { "type": "object" } },
        "extraEgress": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
